---
export interface Props {
  id: string;
  name: string;
  logo: string;
  logoType?: 'image' | 'letter';
  logoBg?: string;
  description: string;
  code: string;
  codeLabel: string;
  url: string;
  category: 'airport' | 'ai';
  perks?: string[];
  featured?: boolean;
}

const { id, name, logo, logoType = 'letter', logoBg, description, code, codeLabel, url, category, perks = [], featured = false } = Astro.props;

const btnClass = category === 'airport'
  ? 'btn btn-primary'
  : (featured ? 'btn btn-featured' : 'btn btn-primary');

const logoStyle = logoType === 'image'
  ? `background: ${logoBg ?? 'transparent'};`
  : `background: linear-gradient(135deg, #7c5cff, #22d3ee);`;

// logo path -> resolved src (handled at build time by Vite)
import youtuniceLogo from '../../public/logos/youtunice.png?url';
import minimaxLogo from '../../public/logos/minimax.png?url';
import opencodeLogo from '../../public/logos/opencode.png?url';

const logoMap: Record<string, string> = {
  youtunice: youtuniceLogo,
  minimax: minimaxLogo,
  opencode: opencodeLogo,
};
const logoSrc = logoMap[id];
---
<article class={`card ${category === 'ai' ? 'ai' : ''} ${featured ? 'featured' : ''}`}>
  {featured && <span class="tag">🔥 热门</span>}
  <div class="card-head">
    <div class="logo" style={logoStyle}>
      {logoType === 'image' && logoSrc
        ? <img src={logoSrc} alt={`${name} logo`} width="48" height="48" loading="lazy" />
        : logo
      }
    </div>
    <div>
      <div class="card-name">{name}</div>
      <div class="card-desc">{description}</div>
    </div>
  </div>
  {perks.length > 0 && (
    <ul class="perks">
      {perks.map((p) => <li>{p}</li>)}
    </ul>
  )}
  <div class="row">
    <div>
      <div class="label">{codeLabel}</div>
      <div class="value" id={`code-${id}`}>{code}</div>
    </div>
    <button class="copy-btn" data-copy={`code-${id}`} aria-label={`复制 ${name} ${codeLabel}`}>复制</button>
  </div>
  <div class="actions">
    <a class={btnClass} href={url} target="_blank" rel="noopener">使用{codeLabel}{category === 'ai' && !featured ? '注册' : (featured ? '订阅' : '注册')} →</a>
  </div>
</article>