---
export interface Props {
  id: string;
  name: string;
  logo: string;
  logoColor: string;
  description: string;
  code: string;
  codeLabel: string;
  url: string;
  category: 'airport' | 'ai';
  perks?: string[];
  featured?: boolean;
}

const { id, name, logo, logoColor, description, code, codeLabel, url, category, perks = [], featured = false } = Astro.props;

const btnClass = featured ? 'btn btn-featured' : (category === 'airport' ? 'btn btn-primary' : 'btn btn-primary');
---
<article class={`card ${category === 'ai' ? 'ai' : ''} ${featured ? 'featured' : ''}`}>
  {featured && <span class="tag">🔥 热门</span>}
  <div class="card-head">
    <div class="logo" style={`background: ${logoColor}`}>{logo}</div>
    <div>
      <div class="card-name">{name}</div>
      <div class="card-desc">{description}</div>
    </div>
  </div>
  {perks.length > 0 && (
    <ul class="perks">
      {perks.map((p) => <li>{p}</li>)}
    </ul>
  )}
  <div class="row">
    <div>
      <div class="label">{codeLabel}</div>
      <div class="value" id={`code-${id}`}>{code}</div>
    </div>
    <button class="copy-btn" data-copy={`code-${id}`} aria-label={`复制 ${name} ${codeLabel}`}>复制</button>
  </div>
  <div class="actions">
    <a class={btnClass} href={url} target="_blank" rel="noopener">使用{codeLabel}{category === 'ai' ? (featured ? '订阅' : '注册') : '注册'} →</a>
  </div>
</article>